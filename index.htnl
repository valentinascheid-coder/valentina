<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Valentina Beauty | Maquiagem Premium</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #FFFDF9;
      color: #4A4A4A;
      line-height: 1.6;
    }
    header {
      background-color: #FAD2E1;
      color: #5A4A42;
      padding: 2.5rem 1rem;
      text-align: center;
    }
    header h1 {
      font-size: 2.2rem;
      margin-bottom: 0.5rem;
    }
    nav {
      background-color: #FFF1C5;
      padding: 0.8rem;
      text-align: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    nav a {
      color: #5A4A42;
      margin: 0 10px;
      text-decoration: none;
      font-weight: bold;
    }
    .container {
      padding: 2rem 1rem;
      max-width: 1000px;
      margin: auto;
    }
    .loja-card {
      background-color: #FFFFFF;
      border: 2px solid #FAD2E1;
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      text-align: center;
    }
    .grid-produtos {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }
    .card-produto {
      background: #FFFFFF;
      border: 2px solid #FFF1C5;
      border-radius: 12px;
      padding: 1rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }
    .card-produto img {
      width: 100%;
      height: 200px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 10px;
    }
    .tag {
      background-color: #FAD2E1;
      color: #D47A9D;
      font-size: 0.75rem;
      font-weight: bold;
      padding: 3px 8px;
      border-radius: 10px;
      display: inline-block;
      margin-bottom: 5px;
    }
    .preco-de {
      text-decoration: line-through;
      color: #999;
      font-size: 0.85rem;
    }
    .preco-por {
      color: #D47A9D;
      font-size: 1.2rem;
      font-weight: bold;
    }
    .btn-comprar {
      display: inline-block;
      background-color: #FFF1C5;
      color: #5A4A42;
      padding: 8px 15px;
      border-radius: 20px;
      text-decoration: none;
      font-weight: bold;
      margin-top: 10px;
    }
    .box-pix {
      background-color: #FFF1C5;
      padding: 1.5rem;
      border-radius: 12px;
      text-align: center;
      margin-top: 2rem;
    }
    footer {
      background-color: #FAD2E1;
      color: #5A4A42;
      text-align: center;
      padding: 1.5rem;
      margin-top: 2rem;
    }
  </style>
</head>
<body>

  <header>
    <h1>Valentina Beauty</h1>
    <p>Boutique de Maquiagem & Cosméticos de Alta Performance</p>
  </header>

  <nav>
    <a href="#loja">Loja Física</a>
    <a href="#produtos">Produtos</a>
    <a href="#pagamento">Pagamento Pix</a>
  </nav>

  <div class="container">

    <section id="loja" class="loja-card">
      <h2>📍 Nossa Loja Presencial</h2>
      <p><strong>Endereço:</strong> Av. Paulista, nº 246 - São Paulo / SP</p>
      <p>Venha testar nossos produtos no nosso camarim iluminado!</p>
    </section>

    <h2 style="text-align: center; margin-bottom: 1.5rem;" id="produtos">Produtos em Destaque</h2>

    <div class="grid-produtos">

      <div class="card-produto">
        <div>
          <img src="https://images.unsplash.com/photo-1586495777744-4413f21062fa?w=500" alt="Batom Gloss">
          <span class="tag">15% OFF</span>
          <h3>Lip Gloss Hydrating</h3>
          <p>Hidratação profunda e brilho espelhado.</p>
        </div>
        <div>
          <p class="preco-de">R$ 89,90</p>
          <p class="preco-por">R$ 76,40</p>
          <a href="#pagamento" class="btn-comprar">Comprar</a>
        </div>
      </div>

      <div class="card-produto">
        <div>
          <img src="https://images.unsplash.com/photo-1512496015851-a90fb38ba796?w=500" alt="Paleta de Sombras">
          <span class="tag">20% OFF</span>
          <h3>Paleta Nude Glow</h3>
          <p>Sombras ultra pigmentadas e aveludadas.</p>
        </div>
        <div>
          <p class="preco-de">R$ 149,00</p>
          <p class="preco-por">R$ 119,20</p>
          <a href="#pagamento" class="btn-comprar">Comprar</a>
        </div>
      </div>

      <div class="card-produto">
        <div>
          <img src="https://images.unsplash.com/photo-1522337360788-8b13dee7a37e?w=500" alt="Pincéis">
          <span class="tag">10% OFF</span>
          <h3>Kit Pincéis Soft Touch</h3>
          <p>Cerdas macias sintéticas de alta precisão.</p>
        </div>
        <div>
          <p class="preco-de">R$ 159,90</p>
          <p class="preco-por">R$ 143,90</p>
          <a href="#pagamento" class="btn-comprar">Comprar</a>
        </div>
      </div>

    </div>

    <section id="pagamento" class="box-pix">
      <h2>💎 Pagamento via Pix</h2>
      <p>Chave Pix E-mail: <strong>pix@valentinabeauty.com.br</strong></p>
      <p>
