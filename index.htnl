<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Valentina Beauty - Beauty & Aesthetic</title>
    
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: #050505;
            color: #e1e4e8;
            line-height: 1.6;
        }

        /* CABEÇALHO JOVEM & CHIC */
        header {
            background: linear-gradient(180deg, #120305 0%, #050505 100%);
            border-bottom: 2px solid #800020;
            padding: 40px 20px;
            text-align: center;
        }

        header h1 {
            color: #ffffff;
            font-size: 36px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            text-shadow: 0 0 12px rgba(128, 0, 32, 0.6);
        }

        header p {
            color: #D4AF37;
            font-size: 15px;
            margin-top: 8px;
            font-weight: 500;
            letter-spacing: 1px;
        }

        .badge-elite {
            display: inline-block;
            background-color: rgba(128, 0, 32, 0.3);
            color: #D4AF37;
            border: 1px solid #D4AF37;
            padding: 6px 18px;
            border-radius: 25px;
            font-size: 12px;
            font-weight: bold;
            margin-top: 15px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        /* BANNER PRINCIPAL */
        .banner-section {
            max-width: 1200px;
            margin: 25px auto;
            padding: 0 15px;
        }

        .banner-card {
            background-color: #0d0d0d;
            border: 1px solid #800020;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 35px rgba(128, 0, 32, 0.35);
            text-align: center;
        }

        .banner-card img {
            width: 100%;
            max-height: 450px;
            object-fit: cover;
            display: block;
        }

        /* CONTAINER DE PRODUTOS */
        main {
            max-width: 1200px;
            margin: 45px auto;
            padding: 0 15px;
        }

        .section-title {
            text-align: center;
            font-size: 26px;
            color: #ffffff;
            margin-bottom: 40px;
            text-transform: uppercase;
            letter-spacing: 3px;
            position: relative;
        }

        .section-title::after {
            content: '';
            display: block;
            width: 80px;
            height: 3px;
            background-color: #D4AF37;
            margin: 12px auto 0;
            border-radius: 2px;
            box-shadow: 0 0 10px #D4AF37;
        }

        /* GRADE DE PRODUTOS */
        .grid-produtos {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 30px;
            justify-content: center;
        }

        /* CARD DE PRODUTO */
        .card-produto {
            background-color: #0a0a0c;
            border: 1px solid #212125;
            border-radius: 16px;
            padding: 22px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 5px 25px rgba(0,0,0,0.8);
        }

        .card-produto:hover {
            transform: translateY(-8px);
            border-color: #800020;
            box-shadow: 0 8px 30px rgba(128, 0, 32, 0.4);
        }

        .img-container {
            width: 100%;
            height: 260px;
            background-color: #030303;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
            overflow: hidden;
        }

        .img-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
            transition: transform 0.4s ease;
        }

        .card-produto:hover .img-container img {
            transform: scale(1.05);
        }

        .card-header {
            margin-bottom: 10px;
        }

        .card-header h3 {
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
        }

        .card-header .categoria {
            color: #D4AF37;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        /* TAGS DE ESTILO JOVEM */
        .tags-container {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin: 12px 0;
        }

        .tag {
            font-size: 11px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 6px;
            background-color: #141418;
            border: 1px solid #2a2a30;
        }

        .tag.red { color: #ff3355; border-color: rgba(255,51,85,0.4); }
        .tag.gold { color: #D4AF37; border-color: rgba(212,175,55,0.4); }
        .tag.green { color: #2ea44f; border-color: rgba(46,164,79,0.4); }

        .descricao-produto {
            font-size: 13.5px;
            color: #9ea7b0;
            margin-bottom: 16px;
            border-top: 1px solid #1a1a1e;
            padding-top: 12px;
        }

        /* LISTA DE ESPECIFICAÇÕES */
        .especificacoes-lista {
            list-style: none;
            font-size: 12.5px;
            margin-bottom: 18px;
            background-color: #040405;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #141418;
        }

        .especificacoes-lista li {
            margin-bottom: 6px;
            display: flex;
            justify-content: space-between;
        }

        .especificacoes-lista li:last-child {
            margin-bottom: 0;
        }

        .especificacoes-lista li span {
            color: #8b949e;
        }

        .especificacoes-lista li strong {
            color: #d1d5da;
        }

        /* PREÇO E BOTAO */
        .preco-box {
            margin-top: 10px;
            border-top: 1px solid #1a1a1e;
            padding-top: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .preco-box .valor {
            color: #D4AF37;
            font-size: 24px;
            font-weight: 800;
            text-shadow: 0 0 8px rgba(212, 175, 55, 0.25);
        }

        .btn-comprar {
            background-color: #800020;
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            font-size: 13px;
            font-weight: 700;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s, box-shadow 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .btn-comprar:hover {
            background-color: #a30029;
            box-shadow: 0 0 15px rgba(128, 0, 32, 0.6);
        }

        /* RODAPÉ COM CONTATO VIP */
        footer {
            background-color: #020202;
            border-top: 1px solid #1a1a1e;
            padding: 45px 20px;
            text-align: center;
